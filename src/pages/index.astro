---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import ArticleExpansion from '../components/works/ArticleExpansion.astro';
import WorkCard from '../components/works/WorkCard.astro';
import OriginCharacter from '../components/works/OriginCharacter.astro';
import VideoModal from '../components/works/VideoModal.astro';
import { formatLabels, validateContentGraph } from '../data/content-graph';
import '../styles/showcase.css';

const episodes = (await getCollection('episodes')).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const catalog = await getCollection('works');
const sourceImages = await getCollection('sourceImages');
validateContentGraph(
  episodes,
  catalog.map((work) => ({ ...work.data, id: work.id })),
  sourceImages,
);
const works = catalog
  .filter((work) => work.data.published)
  .sort((a, b) => a.data.priority - b.data.priority);
const originals = works.filter(
  (work) => work.data.collection === 'original' && work.data.format !== 'motion-comic',
);
const litLink = import.meta.env.PUBLIC_ROMACO_LITLINK_URL ?? 'https://lit.link/Romaco';
const substack = import.meta.env.PUBLIC_ROMACO_SUBSTACK_URL ?? 'https://substack.com/@romaco';
const game = import.meta.env.PUBLIC_ROMACO_GAME_URL ?? 'https://booth.pm/ja/items/8668950';
const creator = import.meta.env.PUBLIC_HAGEDANGO_X_URL ?? 'https://x.com/dango333';
const share =
  import.meta.env.PUBLIC_X_SHARE_URL ??
  'https://twitter.com/intent/tweet?text=' +
    encodeURIComponent('読むロマ子様。動くロマ子様。広がるロマ子様。Romaco-sama Creative Showcase');
const heroVideo = works.find((work) => work.id === 'promo-video-sample-01')!;
if (heroVideo.data.media.type !== 'youtube') {
  throw new Error('Hero game introduction must have a YouTube video.');
}
const groups = [
  {
    id: 'opal-remotion',
    title: 'メッセージを届ける',
    subtitle: 'ロマ子様から、ひと言。',
    description:
      '画面から直接語りかけるメッセージや、イベントの動的告知映像。あの一枚のロマ子様が言葉を紡ぎます。',
  },
  {
    id: 'cooking',
    title: '日常で出会う',
    subtitle: '今日も、ロマ子様と。',
    description: '食材のシズル感や調理のひとコマ。日常をシネマティックに魅せる映像作品。',
  },
  {
    id: 'experiments',
    title: '作品の世界へ誘う',
    subtitle: '気になったら、その先へ。',
    description: 'MVやゲーム紹介映像。作品の世界観を広げ、次の体験へ誘うプロモーション映像。',
  },
];
const links = [
  { title: 'Romaco-sama Lit.Link', label: '活動をもっと知る', href: litLink },
  { title: 'ロマ子様のSubstack', label: '言葉の続きを読む', href: substack },
  { title: '観測してはいけない女', label: 'ゲームの世界へ', href: game },
];
---

<BaseLayout
  title="Romaco-sama Creative Showcase | Produced by Hagedango"
  description="読むロマ子様。動くロマ子様。広がるロマ子様。記事や画像から生まれた4コマ漫画、ショート、講座、料理、MVを楽しむPRショウケース。"
>
  <a class="skip-link" href="#main-content">作品へ移動</a>
  <header class="site-header glass">
    <a class="brand" href="#top"
      ><span class="brand-mark" aria-hidden="true">RC</span><span>ROMACO-SAMA</span></a
    >
    <nav aria-label="メインナビゲーション">
      <a href="#multi-use">記事から</a><a href="#originals">画像・アイデアから</a><a href="#links"
        >もっと楽しむ</a
      >
    </nav>
    <a class="header-link" href={litLink} target="_blank" rel="noreferrer">活動リンク ↗</a>
  </header>

  <main id="main-content">
    <section id="top" class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Nonoshiri Romaco Showcase</p>
        <h1 id="hero-title">
          読むロマ子様。<br />動くロマ子様。<br /><span>広がるロマ子様。</span>
        </h1>
        <p class="hero-lead">
          あの記事、あの一枚から、漫画・ショート・講座、そして新しい映像へ。<br
          />ロマ子様の言葉と世界観を、いろいろなかたちでお楽しみください。
        </p>
        <div class="actions">
          <a class="button primary" href="#multi-use">ロマ子様の作品を見る ↓</a>
          <a class="button secondary" href={substack} target="_blank" rel="noreferrer"
            >原典のSubstackを読む ↗</a
          >
        </div>
        <p class="hero-credit">Creative Showcase · Produced by はげだんご</p>
      </div>
      <div class="hero-art" aria-label="ロマ子様作成ゲーム紹介">
        <iframe
          class="hero-video"
          src={`https://www.youtube-nocookie.com/embed/${heroVideo.data.media.youtubeId}?playsinline=1&rel=0`}
          title={heroVideo.data.title}
          width="640"
          height="360"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
        <div class="hero-art-caption">
          <span>ロマ子様のゲームの世界へ</span>
          <strong>{heroVideo.data.title}</strong>
          <span>{heroVideo.data.description}</span>
        </div>
      </div>
    </section>

    <section class="section container" id="multi-use" aria-labelledby="expansion-title">
      <SectionHeading
        id="expansion-title"
        eyebrow="01 / From a story"
        title="記事から広がるコンテンツ"
        description="同じお話が、漫画にも、短い映像にも、じっくり学ぶ講座にも。原典と作品を見比べてみてください。"
      />
      <div class="episode-selector" hidden data-selector>
        <label for="episode-choice">原典を選ぶ</label>
        <select id="episode-choice"
          >{
            episodes.map((episode) => (
              <option value={episode.id}>
                {episode.id} / {episode.data.title}
              </option>
            ))
          }</select
        >
        <p aria-live="polite" data-episode-status></p>
      </div>
      {episodes.map((episode) => <ArticleExpansion episode={episode} works={works} />)}
    </section>

    <section class="section container" id="works" aria-labelledby="episodes-title">
      <SectionHeading
        id="episodes-title"
        eyebrow="More stories"
        title="ほかのお話も、覗いてみる？"
        description="気になる原典を選ぶと、その記事から生まれた作品が見られます。"
      />
      <div class="filter-row" aria-label="掲載形式で記事を絞り込む" data-episode-filters hidden>
        <button type="button" data-format-filter="all" aria-pressed="true"
          >すべて / 原典エッセイ</button
        >
        {
          (['comic', 'motion-comic', 'short', 'lecture'] as const).map((format) => (
            <button type="button" data-format-filter={format} aria-pressed="false">
              {formatLabels[format]}
            </button>
          ))
        }
      </div>
      <p class="small-note" data-episode-count aria-live="polite">{episodes.length}件の原典記事</p>
      <div class="episode-grid">
        {
          episodes.map((episode) => {
            const formats = [
              ...new Set(
                works
                  .filter((work) => work.data.episodeId === episode.id)
                  .map((work) => work.data.format),
              ),
            ];
            return (
              <article class="episode-card glass" data-episode-formats={formats.join(' ')}>
                <a href={'#' + episode.id} data-select-episode={episode.id}>
                  {episode.data.poster && (
                    <img
                      src={episode.data.poster}
                      alt={episode.data.title + 'の原典記事画像'}
                      width="640"
                      height="360"
                      loading="lazy"
                    />
                  )}
                  <div class="episode-card-body">
                    <>
                      <p class="eyebrow">
                        {episode.id} · {episode.data.classification}
                      </p>
                      <h3>{episode.data.title}</h3>
                    </>
                    <div class="badges" aria-label="掲載中の形式">
                      {formats.map((format) => (
                        <span>{formatLabels[format]}</span>
                      ))}
                    </div>
                    <span class="watch-link">この原典の展開を見る ↑</span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
      <p data-no-episodes hidden>
        この形式の掲載作品はまだありません。ほかの形式からお楽しみください。
      </p>
      <a
        class="text-link"
        href="https://romaco-substack-portal.pages.dev/content-map/"
        target="_blank"
        rel="noreferrer">メディアポータルでコンテンツマップを見る ↗</a
      >
    </section>

    <section class="original-section section" id="originals" aria-labelledby="originals-title">
      <div class="container">
        <SectionHeading
          id="originals-title"
          eyebrow="02 / From an image"
          title="ロマ子様の魅力を、いろんな届け方で。"
          description="ひと言伝えたいときも、おいしい時間も、新しい作品のお知らせも。あの一枚のロマ子様が、いろんな場面で動き出します。"
        />
        <OriginCharacter />
        <div class="original-grid">
          {
            groups.map((group) => {
              const groupWorks = originals.filter((work) => work.data.originalGroup === group.id);
              const featured = groupWorks[0];
              const extras = groupWorks.slice(1);
              return (
                <section class="original-group" aria-labelledby={'group-' + group.id}>
                  <div class="group-heading">
                    <p class="eyebrow">{group.subtitle}</p>
                    <h3 id={'group-' + group.id}>{group.title}</h3>
                    <p>{group.description}</p>
                  </div>
                  <div class="representative-work">
                    {featured && <WorkCard work={featured} featured />}
                  </div>
                  <div class="additional-works">
                    {extras.length > 0 && (
                      <div class="more-works-panel">
                        <p class="more-works-summary">
                          ほかの動画を見る（{extras.length}本）
                        </p>
                        <div class="more-works-list">
                          {extras.map((work) => (
                            <WorkCard work={work} />
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </section>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="section container" id="links" aria-labelledby="links-title">
      <SectionHeading
        id="links-title"
        eyebrow="Follow Romaco-sama"
        title="ロマ子様を、もっと楽しむ。"
        description="言葉の続きも、次の配信も。ロマ子様の世界へ。"
      />
      <div class="links-grid">
        {
          links.map((link) => (
            <a class="romaco-link glass" href={link.href} target="_blank" rel="noreferrer">
              <>
                <span>{link.label}</span>
                <strong>{link.title}</strong>
                <span aria-hidden="true">↗</span>
              </>
            </a>
          ))
        }
      </div>
      <div class="reaction">
        <p>お気に入りの作品が見つかったら、感想を叫んでください。</p><a
          class="button primary"
          href={share}
          target="_blank"
          rel="noreferrer">Xで感想・リアクションをシェア ↗</a
        >
      </div>
    </section>
  </main>
  <footer id="credit">
    <div class="container">
      <p class="credit">
        Produced &amp; Crafted by はげだんご <a href={creator} target="_blank" rel="noreferrer"
          >@dango333</a
        >
      </p>
      <p>
        ロマ子様の記事や画像をもとに、漫画・映像・講座へ。生成・編集・モーション・実装を担当しています。
      </p>
      <p>
        <a href={creator} target="_blank" rel="noreferrer"
          >お手元の記事や画像も、こんなふうに広げてみたい方は、制作担当のXへどうぞ。</a
        >
      </p>
      <div class="footer-bottom">
        <span>© 2026 Romaco-sama Creative Showcase</span><a href="#top">ページの先頭へ ↑</a>
      </div>
    </div>
  </footer>
  <VideoModal />
</BaseLayout>
<script>
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-episode-panel]'));
  const select = document.querySelector<HTMLSelectElement>('#episode-choice');
  const status = document.querySelector<HTMLElement>('[data-episode-status]');
  const ids = new Set(panels.map((panel) => panel.id));
  function showEpisode(id: string, focus = false) {
    if (!ids.has(id)) return;
    panels.forEach((panel) => {
      panel.hidden = panel.id !== id;
    });
    if (select) select.value = id;
    const heading = document.getElementById(id + '-title');
    if (status) status.textContent = id + 'を表示中';
    if (focus && heading) {
      heading.focus({ preventScroll: true });
      heading.scrollIntoView({
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
        block: 'start',
      });
    }
  }
  if (select && panels.length) {
    document.querySelector<HTMLElement>('[data-selector]')!.hidden = false;
    function revealHashTarget() {
      const id = location.hash.slice(1);
      const target = document.getElementById(id);
      const panel = target?.closest<HTMLElement>('[data-episode-panel]');
      if (panel) showEpisode(panel.id);
      else if (ids.has(id)) showEpisode(id);
      else return false;
      let ancestor = target?.parentElement;
      while (ancestor) {
        if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
        ancestor = ancestor.parentElement;
      }
      return true;
    }
    if (!revealHashTarget()) showEpisode('EP-0001');
    select.addEventListener('change', () => {
      history.pushState(null, '', '#' + select.value);
      showEpisode(select.value, true);
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-select-episode]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0)
          return;
        event.preventDefault();
        const id = link.dataset.selectEpisode!;
        history.pushState(null, '', '#' + id);
        showEpisode(id, true);
      });
    });
    addEventListener('hashchange', () => {
      const hash = location.hash.slice(1);
      const containingPanel = document
        .getElementById(hash)
        ?.closest<HTMLElement>('[data-episode-panel]');
      if (ids.has(hash)) showEpisode(hash, true);
      else if (containingPanel) revealHashTarget();
    });
  }
  const filterBar = document.querySelector<HTMLElement>('[data-episode-filters]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-episode-formats]'));
  if (filterBar) {
    filterBar.hidden = false;
    const buttons = filterBar.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const format = button.dataset.formatFilter;
        let count = 0;
        cards.forEach((card) => {
          card.hidden =
            format !== 'all' && !card.dataset.episodeFormats?.split(' ').includes(format!);
          if (!card.hidden) count++;
        });
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        document.querySelector<HTMLElement>('[data-episode-count]')!.textContent =
          count + '件の原典記事';
        document.querySelector<HTMLElement>('[data-no-episodes]')!.hidden = count > 0;
      }),
    );
  }
</script>
