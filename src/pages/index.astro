---
import { getCollection } from 'astro:content';
import SectionHeading from '../components/common/SectionHeading.astro';
import WorkCard from '../components/works/WorkCard.astro';
import { workCategories } from '../data/categories';
import BaseLayout from '../layouts/BaseLayout.astro';

const allWorks = await getCollection('works');
const works = allWorks
  .filter(({ data }) => data.published || data.seed)
  .sort((a, b) => a.data.priority - b.data.priority || b.data.year - a.data.year);

const heroWorks = works.slice(0, 5);
const litLinkUrl = import.meta.env.PUBLIC_ROMACO_LITLINK_URL ?? 'https://lit.link/Romaco';
const gameUrl = import.meta.env.PUBLIC_ROMACO_GAME_URL ?? 'https://booth.pm/ja/items/8668950';
const substackUrl = import.meta.env.PUBLIC_ROMACO_SUBSTACK_URL ?? 'https://substack.com/@romaco';
const hagedangoXUrl = import.meta.env.PUBLIC_HAGEDANGO_X_URL ?? 'https://x.com/dango333';
const contentMapUrl = 'https://romaco-substack-portal.pages.dev/content-map/';
const flagshipEpisode = works.find((work) => work.data.episodeId === 'EP-0001');
const shareText =
  '1つのキャラクター、1つの文章から、ここまで広がる。Romaco-sama Creative Showcase、これは見ろ。';
const xShareUrl =
  import.meta.env.PUBLIC_X_SHARE_URL ??
  `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}`;

const creativeFormats = [
  {
    icon: '🖼️',
    title: '4コマ漫画',
    description: 'キャラクターの静止画を、読めるコミックへ。',
    sample:
      'https://romaco-substack-portal.pages.dev/media/EP-0001/quantum-comic-01.png',
    sampleAlt: 'EP-0001 量子力学エピソードの4コマ漫画サンプル',
    href: '#works',
    filter: 'four-panel',
    label: 'EP-0001 comic',
    tone: 'comic',
    preview: 'image',
  },
  {
    icon: '🎬',
    title: '動く4コマ',
    description: 'Remotionでコマ割りをコードモーション化。',
    sample: 'https://img.youtube.com/vi/4Gqv7d6ShXA/hqdefault.jpg',
    sampleAlt: 'EP-0001の動く4コマ・Remotion展開を示す動画サムネイル',
    href: '#works',
    filter: 'remotion',
    label: 'motion preview',
    tone: 'motion',
    preview: 'video',
  },
  {
    icon: '📱',
    title: 'ショート動画',
    description: '縦型SNS向けに字幕とテンポを最適化。',
    sample: 'https://img.youtube.com/vi/he-0c5CYyS8/hqdefault.jpg',
    sampleAlt: 'EP-0008のショート動画プレビューサムネイル',
    href: '#works',
    filter: 'short-video',
    label: 'vertical shorts',
    tone: 'short',
    preview: 'phone',
  },
  {
    icon: '🍳',
    title: '料理シネマ動画',
    description: '最新AIでシズル感と映画的な空気を生成。',
    sample: 'https://img.youtube.com/vi/qfpKfBIuMc4/hqdefault.jpg',
    sampleAlt: '料理シネマ動画のYouTube Shortsプレビューサムネイル',
    href: '#works',
    filter: 'sizzle',
    label: 'cooking short',
    tone: 'sizzle',
    preview: 'phone',
  },
  {
    icon: '🎓',
    title: '講座動画',
    description: 'スライドと音声で教材・解説動画へ展開。',
    sample: 'https://img.youtube.com/vi/C4k87y6XJJQ/hqdefault.jpg',
    sampleAlt: 'EP-0005の講座動画プレビューサムネイル',
    href: '#works',
    filter: 'education',
    label: 'lecture deck',
    tone: 'lecture',
    preview: 'slide',
  },
];

const romacoLinks = [
  {
    label: '総合リンク',
    title: 'Romaco-sama Lit.Link',
    description: '配信、SNS、活動情報をまとめて追う入口。',
    href: litLinkUrl,
    tone: 'cyan',
  },
  {
    label: 'ゲーム',
    title: '観測してはいけない女',
    description: 'BOOTHで公開中のRomaco-samaゲーム。',
    href: gameUrl,
    tone: 'gold',
  },
  {
    label: 'エッセイ',
    title: 'Romaco-sama Substack',
    description: '毒舌の奥にある思想と物語を読むニュースレター。',
    href: substackUrl,
    tone: 'purple',
  },
];

const multiUseSteps = [
  {
    number: '01',
    title: 'Substack原典',
    purpose: 'EP-0001「量子力学は、天才たちの正気を壊した」を思想の源泉にする。',
    proof: '原典記事・思考法',
  },
  {
    number: '02',
    title: '4コマ漫画',
    purpose: '抽象的な科学テーマを、Romaco-samaの罵倒とオチで読み切れる形へ圧縮する。',
    proof: '公開ポータル掲載',
  },
  {
    number: '03',
    title: 'Shorts / Remotion',
    purpose: 'コマ割り、字幕、視線誘導を時間軸へ置き換え、SNSで届く短尺へ展開する。',
    proof: 'コードモーション・縦型動画',
  },
  {
    number: '04',
    title: '講座動画',
    purpose: '難解なテーマを音声・スライド・字幕で理解できる教材型コンテンツへ変換する。',
    proof: '講座動画公開',
  },
];

const craftNotes = [
  '本サイト内の4コマ漫画、Remotion動画、料理シネマ、講座動画はすべて、はげだんごが最新AIとコード技術で制作・実装しています。',
  '素材をただ並べるだけではなく、Romaco-samaの毒舌エンタメが媒体ごとにどう変化するかまで設計します。',
  'はげだんごは専属技術班／AIクリエイターとして、生成、編集、モーション、実装をつなぎます。',
];
---

<BaseLayout
  title="Romaco-sama Creative Showcase | Produced by Hagedango"
  description="1つのキャラクター、1つの文章から、4コマ漫画、動く4コマ、ショート動画、料理シネマ、講座動画へ。最新AIとコード技術によるマルチ展開ショウケースです。"
>
  <header class="site-header glass">
    <a class="brand" href="#top" aria-label="Romaco-sama Creative Showcase ホーム">
      <span class="brand-mark" aria-hidden="true">RC</span><span>ROMACO-SAMA</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <a href="#works">Works</a><a href="#multi-use">Multi-Use</a><a href="#credit">Credit</a><a
        href="#links">Links</a
      >
    </nav>
    <a class="header-cta" href={hagedangoXUrl} target="_blank" rel="noreferrer">制作相談</a>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true">
        {
          heroWorks.map((work, index) => (
            <figure class:list={['hero-frame', `hero-frame-${index + 1}`]}>
              <img src={work.data.poster.src} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
              <figcaption>{work.data.category}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="container hero-content">
        <p class="eyebrow">Nonoshiri Romaco Showcase</p>
        <h1 id="hero-title">罵尻ロマ子（Romaco-sama）Creative Showcase</h1>
        <p class="hero-copy">
          1つのキャラクター、1つの文章から、ここまで広がる――。
          静止画から、動く漫画、ショート、シネマ、講座動画へ。最新AI×コード技術によるマルチ展開ショウケース。
        </p>
        <div class="format-showcase" aria-label="制作できるクリエイティブ">
          {
            creativeFormats.map((format) => (
              <a
                class:list={['format-card', 'glass', `format-card-${format.tone}`]}
                href={format.href}
                data-jump-filter={format.filter}
              >
                <span class:list={['sample-frame', `sample-${format.preview}`]}>
                  <img src={format.sample} alt={format.sampleAlt} loading="lazy" decoding="async" />
                  {(format.preview === 'video' || format.preview === 'phone' || format.preview === 'slide') && (
                    <span class="play-badge" aria-hidden="true">▶</span>
                  )}
                  <span class="sample-label">{format.label}</span>
                </span>
                <span class="format-copy">
                  <span class="format-icon" aria-hidden="true">{format.icon}</span>
                  <strong>{format.title}</strong>
                  <span>{format.description}</span>
                </span>
              </a>
            ))
          }
        </div>
        <p class="credit-line">
          Produced & Crafted by はげだんご <a
            href={hagedangoXUrl}
            target="_blank"
            rel="noreferrer">@dango333</a
          >
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#works">作品ギャラリーを見る</a>
          <a class="button button-secondary" href={hagedangoXUrl} target="_blank" rel="noreferrer"
            >制作相談をX DMへ</a
          >
          <a class="button button-secondary" href={xShareUrl} target="_blank" rel="noreferrer"
            >Xで感想を叫ぶ</a
          >
        </div>
        <p class="consult-note">
          自分のキャラクターや教材も、こんな風に動かしてみたい方へ。制作・マルチ展開の相談は、はげだんごのX DMへお気軽にどうぞ。
        </p>
        <dl class="hero-stats" aria-label="展示カテゴリ">
          <div><dt>Core</dt><dd>Romaco-sama</dd></div>
          <div><dt>Episodes</dt><dd>{works.length}</dd></div>
          <div><dt>Filters</dt><dd>{workCategories.length + 1}</dd></div>
        </dl>
      </div>
      <a class="scroll-cue" href="#works"><span>Scroll</span><span aria-hidden="true">↓</span></a>
    </section>

    <section class="works-section" id="works" aria-labelledby="works-title">
      <div class="container">
        <div class="section-row">
          <SectionHeading
            id="works-title"
            eyebrow="Works Gallery"
            title="Substack原典から広がった、本物の作品群。"
            description="公開済みポータルの7エピソードを、4コマ、ショート、講座、原典エッセイの実績として整理。カードから原典記事や各公開アセットへ直接飛べます。"
          />
          <p class="works-count" aria-live="polite">
            <span data-visible-count>{works.length}</span>件表示
          </p>
        </div>

        <div class="filter-bar" role="tablist" aria-label="作品カテゴリ">
          <button type="button" data-filter="all" aria-selected="true">すべて</button>
          {
            workCategories.map((category) => (
              <button type="button" data-filter={category.slug} aria-selected="false">
                {category.label}
              </button>
            ))
          }
        </div>
        <p class="source-note">
          Source: <a href={contentMapUrl} target="_blank" rel="noreferrer"
            >Romaco-sama Substack Portal Content Map</a
          >（原典7 / 4コマ4 / ショート6 / 講座2）
        </p>

        {
          works.length > 0 ? (
            <div class="works-grid">
              {works.map((work) => (
                <WorkCard work={work} />
              ))}
            </div>
          ) : (
            <div class="empty-state glass">
              <p class="eyebrow">Archive preparing</p>
              <p>公開許諾済みの作品を準備しています。</p>
            </div>
          )
        }
      </div>
    </section>

    <section class="multi-use" id="multi-use" aria-labelledby="multi-use-title">
      <div class="container">
        <SectionHeading
          id="multi-use-title"
          eyebrow="1 Source Multi-Use"
          title="EP-0001を見れば、マルチ展開力が一発で分かる。"
          description="ひとつのSubstack記事を起点に、4コマ、Shorts、Remotion的なコードモーション、講座動画まで展開する。Romaco-samaの毒舌エンタメを媒体ごとに変換する実例です。"
        />

        <div class="multi-use-board">
          <div class="source-card glass">
            <span class="eyebrow">Flagship Case</span>
            <strong>EP-0001 量子力学</strong>
            <span class="source-summary"
              >知らない方が幸せだった。量子力学は、天才たちの正気を壊した</span
            >
            {
              flagshipEpisode?.data.externalUrl && flagshipEpisode.data.portalUrl && (
                <div class="source-actions">
                  <a href={flagshipEpisode.data.externalUrl} target="_blank" rel="noreferrer">
                    原典を読む
                  </a>
                  <a href={flagshipEpisode.data.portalUrl} target="_blank" rel="noreferrer">
                    展開を見る
                  </a>
                </div>
              )
            }
          </div>
          <ol class="multi-use-flow">
            {
              multiUseSteps.map((step) => (
                <li>
                  <span class="step-number">{step.number}</span>
                  <div>
                    <strong>{step.title}</strong>
                    <p>{step.purpose}</p>
                    <small>{step.proof}</small>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="credit-section" id="credit" aria-labelledby="credit-title">
      <div class="container credit-grid">
        <SectionHeading
          id="credit-title"
          eyebrow="Produced & Crafted"
          title="専属技術班として、Romaco-samaの見せ場を増やす。"
          description="はげだんごは前に出すぎず、制作と演出で世界観を支えるAIクリエイターとしてクレジットします。"
        />
        <div class="credit-card glass">
          <p class="credit-name">
            Produced by はげだんご <a href={hagedangoXUrl} target="_blank" rel="noreferrer"
              >@dango333</a
            >
          </p>
          <ul>
            {craftNotes.map((note) => <li>{note}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="links-section" id="links" aria-labelledby="links-title">
      <div class="container">
        <SectionHeading
          id="links-title"
          eyebrow="Romaco Links"
          title="気になったら、女王の領地へ。"
          description="Romaco-samaの活動、ゲーム、エッセイへすぐ飛べる関連リンクです。"
        />
        <div class="romaco-links">
          {
            romacoLinks.map((link) => (
              <a
                class:list={['romaco-link', 'glass', `romaco-link-${link.tone}`]}
                href={link.href}
                target="_blank"
                rel="noreferrer"
              >
                <span>{link.label}</span>
                <strong>{link.title}</strong>
                <small>{link.description}</small>
              </a>
            ))
          }
        </div>
        <div class="reaction-panel glass">
          <p>
            見た感想は、Xでそのまま叫んでください。自分のキャラクターや教材も動かしてみたい方は、制作担当へ気軽に声をかけてください。
          </p>
          <div class="reaction-actions">
            <a class="button button-primary" href={xShareUrl} target="_blank" rel="noreferrer"
              >Xで感想・リアクションを叫ぶ</a
            >
            <a class="button button-secondary" href={hagedangoXUrl} target="_blank" rel="noreferrer"
              >制作担当に相談する</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <div>
        <span>© 2026 Romaco-sama Creative Showcase.</span>
        <p>
          自分のキャラクターや教材も、こんな風に動かしてみたい方へ。制作・マルチ展開のご相談は、制作担当（はげだんご <a
            href={hagedangoXUrl}
            target="_blank"
            rel="noreferrer">@dango333</a
          >）のX DMへお気軽にどうぞ。
        </p>
      </div>
      <a href="#top">Back to top</a>
    </div>
  </footer>
</BaseLayout>

<script is:inline>
  const buttons = Array.from(document.querySelectorAll('[data-filter]'));
  const cards = Array.from(document.querySelectorAll('.works-grid [data-categories]'));
  const count = document.querySelector('[data-visible-count]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.getAttribute('data-filter');
      let visible = 0;

      cards.forEach((card) => {
        const categories = card.getAttribute('data-categories')?.split(' ') ?? [];
        const matches = selected === 'all' || categories.includes(selected);
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      buttons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
      if (count) count.textContent = String(visible);
    });
  });

  document.querySelectorAll('[data-jump-filter]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const selected = link.getAttribute('data-jump-filter');
      const target = document.querySelector('#works');
      const button = selected
        ? document.querySelector(`[data-filter="${CSS.escape(selected)}"]`)
        : null;

      if (target instanceof HTMLElement) {
        event.preventDefault();
        if (button instanceof HTMLButtonElement) button.click();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: var(--z-header);
    top: var(--space-4);
    left: 50%;
    display: flex;
    width: min(calc(100% - 2rem), var(--content-wide));
    min-height: 4rem;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    transform: translateX(-50%);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .brand-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid rgb(242 199 110 / 62%);
    border-radius: 50%;
    box-shadow: var(--glow-gold);
    color: var(--color-gold);
    letter-spacing: 0;
  }
  nav {
    display: flex;
    margin-left: auto;
    gap: var(--space-5);
  }
  nav a,
  footer a,
  .credit-line a,
  .credit-name a {
    color: var(--color-cyan);
    font-size: var(--step--1);
    text-decoration: none;
  }
  .header-cta,
  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-5);
    border-radius: var(--radius-pill);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }
  .header-cta,
  .button-primary {
    background: linear-gradient(110deg, var(--color-gold), var(--color-cyan));
    box-shadow: 0 8px 30px rgb(242 199 110 / 18%);
    color: var(--color-bg);
  }
  .hero {
    position: relative;
    display: grid;
    min-height: 92svh;
    align-items: end;
    overflow: hidden;
    padding-block: 8.5rem clamp(5.5rem, 12vh, 8rem);
  }
  .hero-media {
    position: absolute;
    z-index: -2;
    inset: 0;
    overflow: hidden;
  }
  .hero-scrim {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(7 10 18 / 96%) 0%, rgb(7 10 18 / 86%) 44%, transparent 100%),
      linear-gradient(180deg, transparent 0%, var(--color-bg) 100%);
  }
  .hero-frame {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 24px 80px rgb(0 0 0 / 42%);
  }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-frame figcaption {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: var(--radius-pill);
    background: rgb(7 10 18 / 72%);
    color: var(--color-text-muted);
    font-size: 0.7rem;
  }
  .hero-frame-1 {
    top: 13%;
    right: 8%;
    width: min(34vw, 27rem);
    aspect-ratio: 16 / 10;
  }
  .hero-frame-2 {
    right: 32%;
    bottom: 7%;
    width: min(24vw, 18rem);
    aspect-ratio: 9 / 12;
  }
  .hero-frame-3 {
    top: 45%;
    right: -2%;
    width: min(22vw, 16rem);
    aspect-ratio: 1;
  }
  .hero-frame-4 {
    top: 8%;
    right: 42%;
    width: min(18vw, 14rem);
    aspect-ratio: 4 / 5;
  }
  .hero-frame-5 {
    right: 18%;
    bottom: -7%;
    width: min(20vw, 16rem);
    aspect-ratio: 16 / 9;
  }
  .hero-content {
    display: grid;
    gap: var(--space-5);
  }
  h1 {
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.04;
    letter-spacing: 0;
  }
  .hero-copy {
    max-width: 49rem;
    color: var(--color-text-muted);
    font-size: var(--step-0);
  }
  .format-showcase {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: min(100%, 72rem);
  }
  .format-card {
    display: grid;
    overflow: hidden;
    min-height: 16rem;
    align-content: stretch;
    gap: 0;
    padding: 0;
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }
  .format-card:hover,
  .format-card:focus-visible {
    transform: translateY(-3px);
  }
  .format-card-comic:hover,
  .format-card-comic:focus-visible,
  .format-card-lecture:hover,
  .format-card-lecture:focus-visible {
    border-color: rgb(242 199 110 / 48%);
    box-shadow: var(--glass-highlight), var(--glow-gold);
  }
  .format-card-motion:hover,
  .format-card-motion:focus-visible,
