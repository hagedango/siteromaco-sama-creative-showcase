---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description?: string;
}
const { id, eyebrow, title, description } = Astro.props;
---

<header class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="description">{description}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    max-width: var(--content-reading);
    gap: var(--space-4);
  }
  h2 {
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    letter-spacing: 0;
  }
  .description {
    color: var(--color-text-muted);
    font-size: var(--step-0);
  }
</style>
