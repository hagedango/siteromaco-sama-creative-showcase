---
import type { CollectionEntry } from 'astro:content';
import { formatLabels } from '../../data/content-graph';
interface Props {
  work: CollectionEntry<'works'>;
  label?: string;
  relationship?: string;
}
const { work, label, relationship } = Astro.props;
const { data } = work;
const portrait = data.format === 'short' || data.aspectRatio === '9:16';
---

<article class="work-card glass" id={work.id} data-work-format={data.format}>
  <a class="work-link" href={data.externalUrl} target="_blank" rel="noreferrer">
    <div class:list={['work-preview', { portrait, comic: data.format === 'comic' }]}>
      <img
        src={data.poster}
        alt={data.title + 'のプレビュー'}
        loading="lazy"
        decoding="async"
        width="480"
        height="360"
      />
      {
        data.media.type === 'youtube' && (
          <span class="play-mark" aria-hidden="true">
            ▶
          </span>
        )
      }
      <span class="preview-tag">{formatLabels[data.format]}</span>
    </div>
    <div class="work-body">
      {relationship && <p class="relationship">{relationship}</p>}
      <h3>{label ?? data.title}</h3>
      <p>{data.description}</p>
      <span class="watch-link"
        >{data.media.type === 'image' ? '漫画を読む' : '動画を見る'}
        <span aria-hidden="true">↗</span></span
      >
    </div>
  </a>
  {data.tools.length > 0 && <p class="tools">{data.tools.join(' / ')}</p>}
  {
    data.media.type === 'image' && data.media.images.length > 1 && (
      <div class="comic-pages" aria-label="漫画の各ページ">
        {data.media.images.map((src, i) => (
          <a href={src} target="_blank" rel="noreferrer">
            {i + 1}ページ目を拡大 ↗
          </a>
        ))}
      </div>
    )
  }
</article>
<style>
  .work-card {
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    transition: border-color 0.2s;
  }
  .work-card:hover {
    border-color: var(--color-gold);
  }
  .work-link {
    display: block;
    text-decoration: none;
  }
  .work-preview {
    position: relative;
    height: clamp(15rem, 24vw, 20rem);
    display: grid;
    place-items: center;
    background: #080d18;
    overflow: hidden;
  }
  .work-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .portrait {
    padding: 0.75rem;
    background: radial-gradient(ellipse at top, #24304a, #080d18 75%);
  }
  .portrait img {
    width: auto;
    max-width: 100%;
    aspect-ratio: 9/16;
    object-fit: cover;
    border: 5px solid #04070d;
    border-radius: 1rem;
  }
  .comic {
    background: #121525;
  }
  .work-body {
    padding: 1.4rem;
    display: grid;
    gap: 0.75rem;
  }
  h3 {
    font-size: 1.2rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }
  .relationship {
    color: var(--color-gold);
    font-size: 0.875rem;
  }
  .watch-link {
    color: var(--color-cyan);
    font-weight: 700;
  }
  .preview-tag {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    border: 1px solid #596170;
    border-radius: 2rem;
    background: #070a12e6;
    padding: 0.2rem 0.7rem;
    font-size: 0.75rem;
  }
  .play-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #070a12cc;
    border: 1px solid #ffffff80;
    color: var(--color-cyan);
  }
  .tools {
    padding: 0 1.4rem 1rem;
    font-size: 0.875rem;
  }
  .comic-pages {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0 1.4rem 1.4rem;
    font-size: 0.875rem;
  }
  .comic-pages a {
    color: var(--color-cyan);
  }
</style>
