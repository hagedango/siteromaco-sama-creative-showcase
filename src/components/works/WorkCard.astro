---
import type { CollectionEntry } from 'astro:content';
import { getCategoryLabel } from '../../data/categories';

interface Props {
  work: CollectionEntry<'works'>;
}
const { work } = Astro.props;
const { data } = work;
const categories = data.categories?.length ? data.categories : [data.category];
const primaryLinks =
  data.links.length > 0
    ? data.links
    : data.externalUrl
      ? [{ label: '原典を読む', href: data.externalUrl }]
      : [];
---

<article class="work-card glass" data-categories={categories.join(' ')}>
  <div class="poster">
    <img
      src={data.poster.src}
      alt={data.posterAlt}
      width={data.poster.width}
      height={data.poster.height}
      loading="lazy"
      decoding="async"
    />
    {data.episodeId && <span class="episode-label">{data.episodeId}</span>}
  </div>
  <div class="body">
    <div class="meta">
      <span>{data.classification ?? getCategoryLabel(data.category)}</span><span aria-hidden="true"
        >·</span
      ><span>{data.year}</span>
    </div>
    <h3>{data.title}</h3>
    <p>{data.shortDescription}</p>
    <div class="format-row" aria-label="展開フォーマット">
      {categories.map((category) => <span>{getCategoryLabel(category)}</span>)}
    </div>
    <div class="detail-row">
      <span>{data.aspectRatio}</span>
      {data.durationSec && <span>{data.durationSec}秒</span>}
      {data.role.slice(0, 2).map((role) => <span>{role}</span>)}
    </div>
    <ul aria-label="使用ツール">{data.tools.slice(0, 3).map((tool) => <li>{tool}</li>)}</ul>
    {primaryLinks.length > 0 && (
      <div class="link-row" aria-label="作品リンク">
        {primaryLinks.slice(0, 4).map((link) => (
          <a class="card-link" href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .work-card {
    overflow: hidden;
    border-radius: var(--radius-lg);
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }
  .work-card:hover {
    border-color: rgb(81 229 255 / 36%);
    transform: translateY(-2px);
  }
  .poster {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
  }
  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .work-card:hover .poster :global(img) {
    transform: scale(1.02);
  }
  .episode-label {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: var(--radius-pill);
    background: rgb(7 10 18 / 78%);
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
  .body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .meta {
    display: flex;
    gap: var(--space-2);
    color: var(--color-cyan);
    font-size: var(--step--1);
    font-weight: 600;
  }
  h3 {
    font-size: var(--step-1);
    line-height: 1.45;
  }
  p {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  .detail-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-subtle);
    font-size: 0.78rem;
  }
  .format-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .format-row span {
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgb(242 199 110 / 32%);
    border-radius: var(--radius-pill);
    background: rgb(242 199 110 / 8%);
    color: var(--color-gold);
    font-size: 0.74rem;
    font-weight: 700;
  }
  .detail-row span {
    border-bottom: 1px solid rgb(255 255 255 / 16%);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-text-subtle);
    font-size: 0.75rem;
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: var(--color-cyan);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
  }
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
